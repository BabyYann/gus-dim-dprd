# ==========================================================
# KONFIGURASI APACHE CPANEL SISTEM GUS DIM
# ==========================================================

# 1. Nonaktifkan penjelajahan direktori
Options -Indexes

# 2. Lindungi file sensitif dan database
<FilesMatch "^(config\.php|\.env|schema\.sql|seeds\.sql|local_db\.json)$">
    Order allow,deny
    Deny from all
</FilesMatch>

# Lindungi folder database
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^database/.*$ - [F,L]
    RewriteRule ^config/.*$ - [F,L]
</IfModule>

# 3. Kompresi Gzip / Deflate untuk kecepatan di HP Relawan
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json application/xml
</IfModule>

# 4. Cache Header untuk Asset Statis
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/jpg "access plus 1 month"
    ExpiresByType image/jpeg "access plus 1 month"
    ExpiresByType image/png "access plus 1 month"
    ExpiresByType image/webp "access plus 1 month"
    ExpiresByType text/css "access plus 1 week"
    ExpiresByType application/javascript "access plus 1 week"
</IfModule>

# 5. Header Keamanan
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set X-XSS-Protection "1; mode=block"
</IfModule>
